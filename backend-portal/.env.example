# Backend environment variables example
# Copy this file to `.env` and replace placeholder values with real credentials.

######### Database (Postgres) #########
# Hostname or endpoint of your Postgres (RDS) instance
DB_HOST=your-db-host.rds.amazonaws.com
# Port for Postgres (default 5432)
DB_PORT=5432
# Database username
DB_USER=your_db_user
# Database password
DB_PASSWORD=your_db_password
# Database name
DB_NAME=your_db_name

######### AWS S3 (Object Storage) #########
# AWS region where the bucket resides (e.g. us-east-1)
AWS_REGION=us-east-1
# AWS access key ID with permissions to put objects
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY_ID
# AWS secret access key
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_ACCESS_KEY
# S3 bucket name used to store uploaded files
AWS_S3_BUCKET_NAME=your-s3-bucket-name

######### Frontend & CORS #########
# Origin allowed by CORS (frontend URL). Use '*' or blank carefully.
CORS_ORIGIN=http://localhost:3000
# Optional: override for the frontend static build path used by express
FRONTEND_BUILD_PATH=frontend-build

# NOTES:
# - Do NOT commit your real `.env` to source control. Keep secrets private.
# - Copy this file: `cp .env.example .env` and fill values before running the server.